{
    "name": "orion-search/testing",
    "description": "In-memory storage, conformance test cases for engine and storage adapters, fault injection and fakes for testing Orion and applications built on it",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "2am.tech",
            "homepage": "https://2am.tech"
        }
    ],
    "require": {
        "php": ">=8.3",
        "orion-search/core": "^1.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Orion\\Testing\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
